# ============================================================
# Clavia — local environment
# Copy to .env and adjust. .env is gitignored; this file is not.
#
# Every CLAVIA_* variable is a field of Clavia\Configuration\Settings;
# `make config` prints them all as the server sees them. Only the ones a
# local setup needs are listed here — later steps add theirs as the
# features they configure arrive.
# ============================================================

# development | staging | production. Several settings below are refused outside
# development, and a few defaults only make sense there.
CLAVIA_ENV=development

# ── Domain ──────────────────────────────────────────────────
# Every host Clavia needs (auth.*, management.*, ...) is derived from this
# single value — see "Domain configuration" in CLAUDE.md. Point it at any
# domain you control locally via /etc/hosts, e.g. clavia.test.
# The issuer (the `iss` claim) is https://auth.{CLAVIA_ROOT_DOMAIN}; set
# CLAVIA_ISSUER_URL only to pin a different value on purpose.
CLAVIA_ROOT_DOMAIN=clavia.test

# ── Reverse proxies ─────────────────────────────────────────
# Whose X-Forwarded-Proto the application believes: addresses or CIDR ranges,
# comma-separated, or * for any. Leave EMPTY for the local setup — Caddy speaks
# FastCGI to PHP and reports the scheme itself. Set it when a load balancer
# terminates TLS in front of the web server.
# CLAVIA_TRUSTED_PROXIES=

# ── Token signing ───────────────────────────────────────────
# postgres | aws-kms | gcp-kms | azure-key-vault | a custom backend's class name
# The cloud backends are non-extractable: the key is generated inside the
# provider's HSM and this process only asks it to sign. `postgres` keeps the key
# itself, encrypted with CLAVIA_SECRET_ENCRYPTION_KEY — right for development,
# weakest in production (the server warns).
CLAVIA_SIGNING_BACKEND=postgres
# Required by every backend except postgres. The provider's key identifier:
#   aws-kms          arn:aws:kms:<region>:<account>:key/<uuid>
#   gcp-kms          projects/…/cryptoKeyVersions/<n>
#   azure-key-vault  https://<vault>.vault.azure.net/keys/<name>/<version>
# Always one immutable key version: an AWS alias, a GCP key without its
# version or an unversioned Key Vault URL is refused at start-up.
# CLAVIA_SIGNING_KEY_REF=
# Rotation for the remote backends, which do not rotate an asymmetric key
# themselves: create a new key at the provider, make it CLAVIA_SIGNING_KEY_REF,
# and list the old one here until every token it signed has expired. Listed keys
# stay in the JWKS and never sign. Comma-separated; refused with postgres, which
# retires its own keys (`clavia keys:rotate`).
# CLAVIA_SIGNING_RETIRED_KEY_REFS=

# Azure Key Vault credentials. Unset, the backend uses the managed identity of the
# Azure host (VM, AKS node, App Service, Container Apps); CLAVIA_AZURE_CLIENT_ID
# alone picks a user-assigned identity. With a tenant and a client id, it signs in
# as that Microsoft Entra application instead — with a secret, or with the token
# AKS workload identity projects into the pod (one or the other, not both).
# CLAVIA_AZURE_TENANT_ID=
# CLAVIA_AZURE_CLIENT_ID=
# CLAVIA_AZURE_CLIENT_SECRET=
# CLAVIA_AZURE_FEDERATED_TOKEN_FILE=/var/run/secrets/azure/tokens/azure-identity-token

# Base64 32-byte key encrypting what must be readable back (the postgres
# backend's signing key, TOTP seeds). REQUIRED for the postgres backend: without
# it key generation and token issuance refuse rather than store the key in the
# clear. Changing it makes existing signing keys unreadable — rotate it only on
# purpose.
CLAVIA_SECRET_ENCRYPTION_KEY=

# ── Development auto-login ──────────────────────────────────
# With this set, /oauth2/authorize treats the named user as signed in whenever
# no session cookie is presented — handy for scripting the flow without a
# browser. It BYPASSES AUTHENTICATION and the server refuses to start with it
# set while CLAVIA_ENV is anything other than "development".
# CLAVIA_DEV_AUTOLOGIN_EMAIL=dev@acme.com

# ── Self-service accounts ───────────────────────────────────
# Sign-up, email verification and password reset (docs/design/self-service-accounts.md).
# Whether a pool takes sign-ups or requires a verified address is set per connection
# (allow_sign_up, require_verified_email), not here. The links go out by email; with
# the default `console` backend, `clavia mail:outbox` shows them.
#
# How long a verification link stays valid, seconds (600–604800; a day).
# CLAVIA_VERIFICATION_LINK_LIFETIME=86400
# How long a password reset link stays valid, seconds (300–86400; half an hour).
# CLAVIA_RESET_LINK_LIFETIME=1800
# Account emails one address, and one client address, may trigger per hour (1–100).
# CLAVIA_ACCOUNT_EMAIL_SEND_LIMIT=5
# Accounts one client address may create from the sign-up page per hour (1–1000).
# CLAVIA_SIGN_UP_LIMIT=10
# Refuse a new password found in Have I Been Pwned's Pwned Passwords, at sign-up, at a
# reset and through the Management API. Only five characters of the password's SHA-1
# leave the server. Off by default because it calls a third party; when the service is
# down, the password is let through and a warning logged.
# CLAVIA_BREACHED_PASSWORD_CHECK=false

# ── Client authentication failures ──────────────────────────
# Failed client authentications and refused grants at the token, introspection,
# revocation and device endpoints, per client address (and per client once it proved
# itself with a secret), before the endpoint answers 429 with Retry-After (at least 1).
# Only failures count: a busy, well-behaved client is never refused.
# CLAVIA_TOKEN_MAX_FAILURES=20
# The window those failures are counted in, seconds (at least 1); every one restarts it.
# CLAVIA_TOKEN_FAILURE_WINDOW=300

# ── Pushed authorization requests and DPoP ──────────────────
# How long a request_uri from /oauth2/par is good for, seconds (5–600; a minute).
# CLAVIA_PAR_LIFETIME=60
# How old a DPoP proof may be, seconds (5–300). A proof is made for one request and
# sent at once (RFC 9449 §11.1).
# CLAVIA_DPOP_PROOF_LIFETIME=60
# How long the server's DPoP nonce is current, seconds (30–3600); the previous one is
# accepted as long again. Each client spends one extra round trip per window.
# CLAVIA_DPOP_NONCE_LIFETIME=300

# ── Dynamic client registration ─────────────────────────────
# RFC 7591 (docs/design/dynamic-client-registration.md). off: no /oauth2/register.
# token: software holding an initial access token an operator issued
# (`clavia clients:registration-token`, or the Management API) registers itself, always
# as a third-party client. Never open to anybody at all.
# CLAVIA_CLIENT_REGISTRATION=off
# Registrations one client address may ask for per window, valid or not (1–1000).
# CLAVIA_CLIENT_REGISTRATION_MAX_PER_ADDRESS=20
# The window those are counted in, seconds (60–86400; an hour).
# CLAVIA_CLIENT_REGISTRATION_WINDOW=3600
# Days a self-registered client never issued a token is kept before
# `clavia clients:purge-unused` (run it daily) deletes it (1–365).
# CLAVIA_CLIENT_REGISTRATION_UNUSED_LIFETIME=30

# Ports Caddy binds on the host. Override both if something else (another
# reverse proxy, an SSH tunnel) already holds 80/443.
CLAVIA_HTTP_PORT=80
CLAVIA_HTTPS_PORT=443

# ── PostgreSQL ────────────────────────────────────────────────
# Read by BOTH docker-compose.yml (to configure the `db` container) and the
# application (to build its connection URL), so the two cannot drift apart.
# CLAVIA_-prefixed so this never collides with another project's Postgres
# settings on the same machine. Set CLAVIA_DATABASE_URL instead to point the
# application at a database Compose does not manage.
#
# CLAVIA_POSTGRES_PORT is the port published on the HOST. Inside the Compose
# network the `php` service reaches `db:5432`; docker-compose.yml overrides the
# host and port for that container, so nothing here needs changing.
CLAVIA_POSTGRES_USER=clavia
CLAVIA_POSTGRES_PASSWORD=clavia
CLAVIA_POSTGRES_DB=clavia
CLAVIA_POSTGRES_PORT=5433
# Host port of the throwaway `db-test` container the test suite uses.
CLAVIA_POSTGRES_TEST_PORT=5434

# ── Redis ─────────────────────────────────────────────────────
# Same arrangement as PostgreSQL: the port published on the host, overridden
# for the `php` container. Sessions, login state and throttle counters live
# here. Set CLAVIA_REDIS_URL instead to point the application at a Redis
# Compose does not manage.
CLAVIA_REDIS_PORT=6379
