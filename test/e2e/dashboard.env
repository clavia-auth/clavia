# The dashboard's settings for the end-to-end stack (compose.yaml, profile `dashboard`): what `seed-dev` prints
# for this domain, and a session secret that is a throwaway published with the repository.
CLAVIA_ISSUER=https://auth.clavia.test
CLAVIA_CLIENT_ID=clavia-dashboard
CLAVIA_CLIENT_SECRET=dev-dashboard-secret-for-local-development-only
CLAVIA_MANAGEMENT_API=https://management.clavia.test/api/v1/
DASHBOARD_URL=https://management.clavia.test/dashboard
DASHBOARD_SESSION_SECRET=ValGDf0mmrNbMahPAvsPtuEQnqei9UISJu3moV6EBc0
DASHBOARD_REDIS_URL=redis://redis:6379/2
# The certificate of auth.clavia.test and management.clavia.test comes from the CA up.sh leaves in .work.
NODE_EXTRA_CA_CERTS=/ca/rootCA.pem
