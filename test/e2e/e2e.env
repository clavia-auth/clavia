# Clavia's settings for the end-to-end stack (compose.yaml). Every value is a throwaway published
# with the repository: this stack listens on 127.0.0.1 only, and holds nothing worth keeping.
CLAVIA_ROOT_DOMAIN=clavia.test
# `development` is what lets `seed-dev` run; docs/design/end-to-end-scenarios.md §2 says why that is
# acceptable, and slice 1 checks that it changes nothing in how a request is handled.
CLAVIA_ENV=development
CLAVIA_SECRET_ENCRYPTION_KEY=8hI474UYRGmmdd+wV+mI2AnK3mqzqT7sNGs5lHzFhaE=
CLAVIA_POSTGRES_HOST=db
CLAVIA_POSTGRES_PORT=5432
CLAVIA_POSTGRES_USER=clavia
CLAVIA_POSTGRES_PASSWORD=clavia
CLAVIA_POSTGRES_DB=clavia
CLAVIA_REDIS_URL=redis://redis:6379/0
# Mail goes to Mailpit over SMTP, as it would to a real server; the suites read it back from there.
CLAVIA_EMAIL_BACKEND=smtp
CLAVIA_EMAIL_FROM=no-reply@clavia.test
CLAVIA_SMTP_HOST=mailpit
CLAVIA_SMTP_PORT=1025
CLAVIA_SMTP_STARTTLS=false
# The send limits (5 account mails and 10 sign-ups an hour) are the acceptance suite's to test; here every
# scenario mails from one address, and the run must not spend a budget it shares.
CLAVIA_ACCOUNT_EMAIL_SEND_LIMIT=100
CLAVIA_SIGN_UP_LIMIT=1000
CLAVIA_SIGNING_BACKEND=postgres
