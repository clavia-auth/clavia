# ============================================================
# Caddyfile — local reverse proxy / TLS for Clavia
#
# Domain-agnostic: every hostname below is built from CLAVIA_ROOT_DOMAIN
# (set in .env, passed through by docker-compose.yml). TLS is mkcert,
# generated by setup-ssl.sh — not ACME/Let's Encrypt.
#
# The application is PHP-FPM (the `php` service), reached over FastCGI. Caddy
# reports the scheme and the client address to PHP itself, so the application
# trusts no X-Forwarded-* header in this setup (CLAVIA_TRUSTED_PROXIES is empty).
# ============================================================

{
	auto_https off
	admin off

	log {
		level INFO
		format console
	}
}

# ── Snippets ──────────────────────────────────────────────────
# mkcert wildcard cert covering *.{CLAVIA_ROOT_DOMAIN}; filenames must match
# what setup-ssl.sh writes into ./certs.
(mkcert_tls) {
	tls /etc/caddy/certs/{$CLAVIA_ROOT_DOMAIN}.pem /etc/caddy/certs/{$CLAVIA_ROOT_DOMAIN}-key.pem
}

# The application: one front controller, public/index.php, for every path that
# is not a file under public/. The root is the path inside the php container —
# docker-compose.yml mounts ./public at the same place in this one, so the
# SCRIPT_FILENAME Caddy computes is one PHP-FPM can open.
(clavia_app) {
	root * /app/public
	php_fastcgi php:9000 {
		# The front controller and nothing else: no other file under public/ is ever
		# executed, and a directory there never triggers a redirect.
		try_files index.php
	}
}

# The application, as the internal listener reaches it: the FastCGI parameter CLAVIA_LISTENER says
# so, and a client cannot set it (its headers reach PHP as HTTP_*). /metrics answers only then.
(clavia_internal) {
	root * /app/public
	php_fastcgi php:9000 {
		try_files index.php
		env CLAVIA_LISTENER internal
	}
}

# ── The internal listener: /healthz and /metrics, not published ─
# docker-compose.yml publishes 80 and 443 only: read it from inside, with
# `docker compose exec caddy wget -qO- http://127.0.0.1:8081/metrics`.
http://:8081 {
	handle /healthz {
		import clavia_internal
	}
	handle /metrics {
		import clavia_internal
	}
	handle {
		respond 404
	}
}

# ── HTTP → HTTPS redirect ─────────────────────────────────────
# auto_https off disables the automatic redirect, so it is declared
# explicitly to give the published port 80 something to do.
http://auth.{$CLAVIA_ROOT_DOMAIN}, http://management.{$CLAVIA_ROOT_DOMAIN} {
	redir https://{host}{uri} permanent
}

# ── OAuth2 / OIDC / login — https://auth.{CLAVIA_ROOT_DOMAIN} ─
# Serves /oauth2/*, /oidc/*, /auth/*, /.well-known/*. Its own origin, isolated
# from management.* — this is where redirect_uris are validated and where the
# host-only session cookie lives.
auth.{$CLAVIA_ROOT_DOMAIN} {
	import mkcert_tls

	# `defer` applies these after the upstream response arrives, so Caddy's value
	# replaces the upstream's rather than being appended alongside it.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		# PHP-FPM states the response code in a CGI `Status` header; it is not an
		# HTTP header and has no business reaching a client.
		-Status
		defer
	}

	# Nothing on this origin may come out of a shared cache — tokens, codes, login
	# pages, redirects that depend on who is signed in (RFC 6749 §5.1) — with the
	# exceptions that exist precisely to be cached: the discovery document, the JWKS
	# (relying parties cache it for the max-age the app sets, which is what makes
	# key rotation safe), each SAML connection's service provider metadata (public,
	# read by identity providers), and static assets. The app sets no-store itself on every
	# sensitive response; this is the belt to those braces.
	@sensitive not path /.well-known/* /oidc/jwks.json /auth/static/* /favicon.ico /auth/saml/*/metadata
	header @sensitive {
		Cache-Control "no-store"
		defer
	}

	# No CORS: no browser origin calls this one. The dashboard is a backend for
	# frontend whose server redeems codes and refreshes tokens itself, and a
	# third-party single-page application is not offered cross-origin access.

	# The Management API lives on management.*, not here. The application serves
	# every surface from one front controller, so the host split is enforced at
	# this layer: a machine plane reachable on the origin where credentials are
	# typed would undo the separation "Domain configuration" in CLAUDE.md calls a
	# security property. The same goes for SCIM (/scim/v2/*), the directories' plane.
	handle /api/v1/* {
		respond 404
	}
	handle /scim/v2/* {
		respond 404
	}
	# Metrics are the internal listener's alone.
	handle /metrics {
		respond 404
	}

	# The auth pages' stylesheet and icon, served from the auth origin so the
	# pages can reference them under a style-src 'self' policy with no inline
	# styles. Files only: nothing under this prefix ever reaches PHP.
	handle /auth/static/* {
		root * /app/public
		file_server
	}

	# Browsers request /favicon.ico at the origin root whenever a page omits an
	# icon link — every error page and JSON response included. The SVG is served
	# under its real media type; every current browser accepts that at this path.
	handle /favicon.ico {
		root * /app/public
		rewrite * /auth/static/clavia-icon.svg
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle {
		import clavia_app
	}
}

# ── Backoffice + Management API — https://management.{CLAVIA_ROOT_DOMAIN} ─
# One origin, two upstreams, each under its own prefix. /api/v1/* is the
# Management API, served by the same PHP application as auth.* — the split
# between the two hosts is Caddy's, not the application's. /dashboard is the
# dashboard: the Next.js server of the clavia-dashboard repository, a backend for
# frontend whose `basePath` is /dashboard (`clavia seed-dev` registers its redirect,
# post-logout and back-channel logout URIs under it). Anything else on this host —
# the root included — has nothing to show and is sent to the dashboard.
# Same origin means the dashboard's own calls to /api/v1/* need no CORS at all,
# and there is deliberately no separate api.* host — see "Domain configuration"
# in CLAUDE.md.
management.{$CLAVIA_ROOT_DOMAIN} {
	import mkcert_tls

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Status
		defer
	}

	# The Management API. Bearer-token-only: no CORS credentials handling here
	# because there is no cross-origin caller that should present a cookie, and
	# a machine client calling from anywhere needs no CORS at all.
	handle /api/v1/* {
		header Cache-Control "no-store" {
			defer
		}
		import clavia_app
	}

	# SCIM 2.0 (RFC 7644): directories provisioning accounts with a provisioning token, the
	# fifth surface. Served by the same PHP application; nothing on it is cacheable.
	handle /scim/v2/* {
		header Cache-Control "no-store" {
			defer
		}
		import clavia_app
	}

	handle /metrics {
		respond 404
	}

	# The dashboard, on the host in development (`npm run dev`, port 3000) or
	# wherever CLAVIA_DASHBOARD_UPSTREAM points. It sets its own headers — a
	# Content-Security-Policy with a nonce per response among them — and the Host
	# header reaches it unchanged: its server actions refuse a request whose Origin
	# does not match the Host it was sent to.
	@dashboard path /dashboard /dashboard/*
	handle @dashboard {
		reverse_proxy {$CLAVIA_DASHBOARD_UPSTREAM:host.docker.internal:3000}
	}

	# Everything else — "/", "/dashboard" without its slash, an old bookmark —
	# goes to the dashboard. Temporary rather than permanent: browsers cache a
	# 301 indefinitely, and the day this host serves something else at "/" a
	# cached permanent redirect would be impossible to take back.
	handle {
		# The explicit `*` matters: a first argument starting with "/" would be
		# read as a path matcher, not as the destination.
		redir * /dashboard 302
	}
}
