<?xml version="1.0"?>
<ruleset name="Clavia">
    <description>PSR-12, with lines kept to 120 characters.</description>

    <arg value="p"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="cache" value=".phpcs-cache"/>

    <rule ref="PSR12"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="120"/>
        </properties>
    </rule>

    <file>bin/clavia</file>
    <file>config</file>
    <file>public</file>
    <file>src</file>
    <file>test</file>
</ruleset>
