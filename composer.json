{
    "name": "clavia/clavia",
    "description": "Open-source OAuth 2.1 / OpenID Connect authorization server",
    "type": "project",
    "license": "BSD-3-Clause",
    "keywords": [
        "oauth2",
        "oauth2.1",
        "openid-connect",
        "oidc",
        "authorization-server",
        "identity-provider"
    ],
    "authors": [
        {
            "name": "Julien Guittard",
            "email": "julien.guittard@me.com"
        }
    ],
    "require": {
        "php": "~8.5.0",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "ext-uri": "*",
        "bacon/bacon-qr-code": "^3.0",
        "laminas/laminas-config-aggregator": "^1.21",
        "laminas/laminas-diactoros": "^3.10",
        "laminas/laminas-httphandlerrunner": "^2.13",
        "laminas/laminas-servicemanager": "^4.6",
        "laminas/laminas-stratigility": "^4.3",
        "laminas/laminas-view": "^3.2",
        "mezzio/mezzio": "^3.29",
        "mezzio/mezzio-fastroute": "^3.15",
        "mezzio/mezzio-laminasviewrenderer": "^3.1",
        "mezzio/mezzio-router": "^4.2",
        "monolog/monolog": "^3.13",
        "php-db/phpdb": "0.6.x-dev",
        "php-db/phpdb-pgsql": "0.1.x-dev",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0",
        "vimeo/psalm": "^7.11",
        "web-token/jwt-library": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Clavia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClaviaTest\\": "test/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@arch",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "static-analysis": "psalm --no-progress",
        "arch": "deptrac analyse --no-progress --fail-on-uncovered --report-uncovered",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-html build/coverage"
    },
    "scripts-descriptions": {
        "check": "Everything a change must pass: coding standard, static analysis, architecture rules, tests.",
        "arch": "Enforce the hexagonal dependency rules (deptrac.yaml)."
    }
}
