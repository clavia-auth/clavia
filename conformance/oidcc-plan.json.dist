{
  "alias": "clavia",
  "description": "Clavia (PHP)",
  "server": {
    "discoveryUrl": "https://auth.{DOMAIN}/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "{CLIENT_ID}",
    "client_secret": "{CLIENT_SECRET}"
  },
  "client2": {
    "client_id": "{CLIENT2_ID}",
    "client_secret": "{CLIENT2_SECRET}"
  },
  "client_secret_post": {
    "client_id": "{POST_CLIENT_ID}",
    "client_secret": "{POST_CLIENT_SECRET}"
  },
  "browser": [
    {
      "match": "https://auth.{DOMAIN}/oauth2/authorize*",
      "tasks": [
        {
          "task": "Login",
          "optional": true,
          "match": "https://auth.{DOMAIN}/auth/login*",
          "commands": [
            [
              "text",
              "id",
              "email",
              "{EMAIL}",
              "optional"
            ],
            [
              "text",
              "id",
              "password",
              "{PASSWORD}",
              "optional"
            ],
            [
              "click",
              "xpath",
              "//form[@action=\"/auth/login\"]//button[@type=\"submit\"]",
              "optional"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/callback*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              10
            ]
          ]
        }
      ]
    }
  ],
  "override": {
    "oidcc-prompt-login": {
      "browser": [
        {
          "match": "https://auth.{DOMAIN}/oauth2/authorize*",
          "tasks": [
            {
              "task": "Login",
              "optional": true,
              "match": "https://auth.{DOMAIN}/auth/login*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Sign in",
                  "update-image-placeholder-optional"
                ],
                [
                  "text",
                  "id",
                  "email",
                  "{EMAIL}",
                  "optional"
                ],
                [
                  "text",
                  "id",
                  "password",
                  "{PASSWORD}",
                  "optional"
                ],
                [
                  "click",
                  "xpath",
                  "//form[@action=\"/auth/login\"]//button[@type=\"submit\"]",
                  "optional"
                ]
              ]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [
                [
                  "wait",
                  "id",
                  "submission_complete",
                  10
                ]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-max-age-1": {
      "browser": [
        {
          "match": "https://auth.{DOMAIN}/oauth2/authorize*",
          "tasks": [
            {
              "task": "Login",
              "optional": true,
              "match": "https://auth.{DOMAIN}/auth/login*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Sign in",
                  "update-image-placeholder-optional"
                ],
                [
                  "text",
                  "id",
                  "email",
                  "{EMAIL}",
                  "optional"
                ],
                [
                  "text",
                  "id",
                  "password",
                  "{PASSWORD}",
                  "optional"
                ],
                [
                  "click",
                  "xpath",
                  "//form[@action=\"/auth/login\"]//button[@type=\"submit\"]",
                  "optional"
                ]
              ]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [
                [
                  "wait",
                  "id",
                  "submission_complete",
                  10
                ]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-ensure-registered-redirect-uri": {
      "browser": [
        {
          "comment": "expect an immediate error page",
          "match": "https://auth.{DOMAIN}/oauth2/authorize*",
          "tasks": [
            {
              "task": "Expect redirect uri mismatch error page",
              "match": "https://auth.{DOMAIN}/oauth2/authorize*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "redirect URI",
                  "update-image-placeholder"
                ]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-ensure-request-object-with-redirect-uri": {
      "browser": [
        {
          "comment": "expect an immediate error page",
          "match": "https://auth.{DOMAIN}/oauth2/authorize*",
          "tasks": [
            {
              "task": "Expect redirect uri mismatch error page",
              "match": "https://auth.{DOMAIN}/oauth2/authorize*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "redirect URI",
                  "update-image-placeholder"
                ]
              ]
            }
          ]
        }
      ]
    }
  }
}
