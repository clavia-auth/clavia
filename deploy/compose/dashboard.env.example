# The dashboard's settings for deploy/compose: copy to dashboard.env and fill in, with the client
# you register for it (docs/PRODUCTION.md, "The dashboard's client").

# Clavia's issuer, as its discovery document states it: https://auth.{domain}
CLAVIA_ISSUER=https://auth.example.com
# The dashboard's confidential client, and its secret (shown once when you register it).
CLAVIA_CLIENT_ID=
CLAVIA_CLIENT_SECRET=
# The Management API: its identifier, which is also where it is served.
CLAVIA_MANAGEMENT_API=https://management.example.com/api/v1/
# Where browsers reach the dashboard.
DASHBOARD_URL=https://management.example.com/dashboard
# 32 random bytes, base64url, encrypting the session records:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
DASHBOARD_SESSION_SECRET=
# The redis service, in a database of the dashboard's own.
DASHBOARD_REDIS_URL=redis://redis:6379/2
