# Clavia's settings for deploy/compose: copy to .env and fill in. Every setting is documented in
# src/Configuration/Settings.php; `docker compose run --rm php php bin/clavia config` prints what
# the server sees (secrets masked). docs/PRODUCTION.md explains each choice.

# ── The release to run (the dashboard's is released at the same version) ──
CLAVIA_VERSION=0.5.1
CLAVIA_DASHBOARD_VERSION=0.5.1

# ── The domain: Clavia serves auth.{domain} and management.{domain} ──
# Both names must point at this host, which must be reachable on ports 80 and 443 for Caddy to
# obtain their certificates.
CLAVIA_ROOT_DOMAIN=example.com
CLAVIA_ENV=production

# ── Secrets ──
# Seals the secrets stored in the database (signing keys with the postgres backend, OIDC client
# secrets, webhook secrets, TOTP seeds). Generate it once:
#   docker compose run --rm --no-deps php php bin/clavia secrets:generate-key
# and keep a copy out of this host: without it, what it sealed cannot be read back.
CLAVIA_SECRET_ENCRYPTION_KEY=

# ── PostgreSQL: the db service, or a managed database (then delete the db service) ──
CLAVIA_POSTGRES_HOST=db
CLAVIA_POSTGRES_PORT=5432
CLAVIA_POSTGRES_USER=clavia
CLAVIA_POSTGRES_PASSWORD=
CLAVIA_POSTGRES_DB=clavia
# Or the whole connection at once, TLS included:
# CLAVIA_DATABASE_URL=postgresql://clavia:secret@db.internal:5432/clavia?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt

# ── Redis: the redis service, or a managed one (rediss:// for TLS) ──
CLAVIA_REDIS_URL=redis://redis:6379/0

# ── Mail: sign-in codes and links, verification and reset links ──
# smtp, or none (passwordless sign-in and emailed links are then off).
CLAVIA_EMAIL_BACKEND=smtp
CLAVIA_EMAIL_FROM=Clavia <no-reply@example.com>
CLAVIA_SMTP_HOST=smtp.example.com
CLAVIA_SMTP_PORT=587
CLAVIA_SMTP_USERNAME=
CLAVIA_SMTP_PASSWORD=

# ── Signing keys ──
# postgres keeps the private key in the database, sealed (a warning in production); a KMS keeps it
# out of this server: aws-kms, gcp-kms or azure-key-vault, with CLAVIA_SIGNING_KEY_REF naming the
# key version. See docs/PRODUCTION.md.
CLAVIA_SIGNING_BACKEND=postgres
# CLAVIA_SIGNING_KEY_REF=arn:aws:kms:eu-west-1:111122223333:key/…
# CLAVIA_AWS_REGION=eu-west-1

# ── SAML service provider keys, if you register SAML connections ──
# CLAVIA_SAML_KEY_BACKEND=postgres

# ── Fine-grained authorization, if you use it: OpenFGA beside Clavia ──
# Start the kit with `--profile fga` (or COMPOSE_PROFILES=fga below) to run OpenFGA and its database,
# then set both settings. A key of your own, 16 to 512 characters: `openssl rand -base64 32`. Then run
# `bin/clavia management-api:register` to register the Authorization API (docs/PRODUCTION.md).
# COMPOSE_PROFILES=fga
# CLAVIA_FGA_URL=http://openfga:8080
# CLAVIA_FGA_API_KEY=
# The password of OpenFGA's own database (not a Clavia setting): `openssl rand -hex 24`.
# OPENFGA_POSTGRES_PASSWORD=
