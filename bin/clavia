declare(strict_types=1);

use Clavia\Configuration\InvalidSettings;
use Clavia\Configuration\Settings;
use Psr\Container\ContainerExceptionInterface;
use Psr\Container\ContainerInterface;
use Symfony\Component\Console\Application;

// Report every PHP error, whatever php.ini says.
error_reporting(E_ALL);

chdir(dirname(__DIR__));

require 'vendor/autoload.php';

(static function (): void {
    /** @var ContainerInterface $container */
    $container = require 'config/container.php';

    try {
        /** @var Settings $settings */
        $settings = $container->get(Settings::class);
    } catch (ContainerExceptionInterface $failure) {
        // The container wraps whatever a factory throws. A configuration Clavia refuses
        // to run with stops every command, with the reason and no stack trace.
        for ($cause = $failure; $cause !== null; $cause = $cause->getPrevious()) {
            if ($cause instanceof InvalidSettings) {
                fwrite(STDERR, 'Invalid configuration: ' . $cause->getMessage() . PHP_EOL);

                exit(78); // EX_CONFIG
            }
        }

        throw $failure;
    }

    foreach ($settings->warnings() as $warning) {
        fwrite(STDERR, 'Warning: ' . $warning . PHP_EOL);
    }

    /** @var Application $application */
    $application = $container->get(Application::class);

    exit($application->run());
})();
