<?php
/**
 * The layout of every page this server renders: the auth pages and the error pages.
 *
 * Variables (set by Clavia\Adapter\Primary\Http\Shared\PageRenderer):
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var string      $language The page's language, a BCP 47 tag: what <html lang> says.
 * @var string      $title
 * @var string      $heading
 * @var string|null $error
 * @var string|null $theme    The forced colour scheme, or null to follow the system.
 * @var string|null $returnTo Where the theme toggle and the language switcher come back to; null leaves
 *                            them out.
 * @var array<string, string> $languages The switcher's choices, tag => name in itself; empty for none.
 * @var bool        $wide     A wider card, for a QR code or a list of codes.
 * @var string|null $script   A module of this server's the page loads; null for none.
 * @var string      $stylesheet The stylesheet's address, versioned by its content (StaticAssets).
 * @var string      $icon       The icon's address, versioned likewise.
 * @var string      $content  The page itself, already rendered.
 *
 * A page puts the line under the heading in the `subtitle` placeholder; it is rendered
 * before the layout, so the layout prints whatever the page captured.
 *
 * No script on these pages but one module of this server's, and only on the page that needs
 * it (`$script`): every other page's policy forbids script, so it cannot run an injected one
 * either, and the one that allows it allows that module and nothing more (see PageRenderer).
 */
?>
<!DOCTYPE html>
<html lang="<?= $this->escapeHtmlAttr($language) ?>"<?php if ($theme !== null): ?> data-theme="<?= $this->escapeHtmlAttr($theme) ?>"<?php endif ?>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="same-origin">
  <title><?= $this->escapeHtml($title) ?> · Clavia</title>
  <link rel="icon" href="<?= $this->escapeHtmlAttr($icon) ?>" type="image/svg+xml">
  <link rel="stylesheet" href="<?= $this->escapeHtmlAttr($stylesheet) ?>">
<?php if ($script !== null): ?>
  <script type="module" src="<?= $this->escapeHtmlAttr($script) ?>"></script>
<?php endif ?>
</head>
<body>
  <main class="card<?php if ($wide): ?> card-wide<?php endif ?>">
    <header class="brand">
      <img class="brand-mark" src="<?= $this->escapeHtmlAttr($icon) ?>" alt="" width="48" height="48">
      <h1><?= $this->escapeHtml($heading) ?></h1>
<?= $this->placeholder('subtitle') ?>
    </header>

<?php if ($error !== null): ?>
    <?= $this->partial('partial::alert', ['message' => $error]) ?>
<?php endif ?>

<?= $content ?>

    <footer class="footer"><?= $this->escapeHtml($this->t('layout.secured_by')) ?> <span class="wordmark">Clavia</span></footer>
  </main>

<?php if ($returnTo !== null): ?>
  <div class="preferences">
<?php if ($languages !== []): ?>
  <!-- The language, as the colour scheme: one form, a button per language named in itself. -->
  <form class="toggle" method="post" action="/auth/language" aria-label="<?= $this->escapeHtmlAttr($this->t('layout.language.label')) ?>">
    <input type="hidden" name="return_to" value="<?= $this->escapeHtmlAttr($returnTo) ?>">
<?php foreach ($languages as $tag => $name): ?>
    <button type="submit" name="language" value="<?= $this->escapeHtmlAttr((string) $tag) ?>" lang="<?= $this->escapeHtmlAttr((string) $tag) ?>"<?php if ($language === (string) $tag): ?> aria-pressed="true"<?php endif ?>><?= $this->escapeHtml($name) ?></button>
<?php endforeach ?>
  </form>
<?php endif ?>
  <!-- The colour scheme is a cookie set by a form post: three buttons on one form, the
       pressed one's value is the choice, and `next` brings the browser back here. -->
  <form class="toggle" method="post" action="/auth/theme" aria-label="<?= $this->escapeHtmlAttr($this->t('layout.theme.label')) ?>">
    <input type="hidden" name="next" value="<?= $this->escapeHtmlAttr($returnTo) ?>">
<?php foreach (['auto' => 'layout.theme.auto', 'light' => 'layout.theme.light', 'dark' => 'layout.theme.dark'] as $value => $label): ?>
    <button type="submit" name="theme" value="<?= $value ?>"<?php if (($theme ?? 'auto') === $value): ?> aria-pressed="true"<?php endif ?>><?= $this->escapeHtml($this->t($label)) ?></button>
<?php endforeach ?>
  </form>
  </div>
<?php endif ?>
</body>
</html>
