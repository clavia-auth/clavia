<?php
/**
 * The device page (RFC 8628 §3.3): the code typed, the question put, the answer given.
 *
 * Every word of the question comes from the server — the application's registered name,
 * the API's definitions — never from the device that asked. Two submit buttons on one
 * form: the decision is the value of the one pressed, with no script.
 *
 * Variables (set by Clavia\Adapter\Primary\Http\Auth\DevicePages):
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var string $csrfToken
 * @var 'entry'|'review'|'done' $stage
 * @var string $userCode   entry and review
 * @var string $clientName review
 * @var string $email      review
 * @var array{oidc: list<array<string, mixed>>, api: array<string, mixed>|null} $scopes What partial::scopes
 *      prints (Clavia\Adapter\Primary\Http\Auth\ScopeWording).
 * @var bool $approved     done
 */
?>
<?php $this->placeholder('subtitle')->captureStart() ?>
<?php if ($stage === 'entry'): ?>
      <p class="subtitle"><?= $this->escapeHtml($this->t('device.entry.subtitle')) ?></p>
<?php elseif ($stage === 'review'): ?>
      <p class="subtitle"><?= $this->emphasised('consent.subtitle', ['application' => $clientName, 'email' => $email], 'application') ?></p>
<?php elseif ($approved): ?>
      <p class="subtitle"><?= $this->escapeHtml($this->t('device.done.connected_hint')) ?></p>
<?php else: ?>
      <p class="subtitle"><?= $this->escapeHtml($this->t('device.done.refused_hint')) ?></p>
<?php endif ?>
<?php $this->placeholder('subtitle')->captureEnd() ?>
<?php if ($stage === 'entry'): ?>
    <form method="post" action="/auth/device" autocomplete="off" novalidate>
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => '']) ?>
      <label for="user_code"><?= $this->escapeHtml($this->t('mfa.code')) ?></label>
      <input id="user_code" name="user_code" type="text" class="code-input" required autofocus value="<?= $this->escapeHtmlAttr($userCode) ?>" placeholder="XXXX-XXXX" spellcheck="false" autocapitalize="characters" autocomplete="off">

      <button type="submit"><?= $this->escapeHtml($this->t('mfa.continue')) ?></button>
    </form>
<?php elseif ($stage === 'review'): ?>
    <p class="hint"><?= $this->escapeHtml($this->t('device.review.code', ['code' => $userCode])) ?></p>
<?= $this->partial('partial::scopes', $scopes) ?>
    <form method="post" action="/auth/device" class="decision">
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => '']) ?>
      <input type="hidden" name="user_code" value="<?= $this->escapeHtmlAttr($userCode) ?>">
      <button type="submit" name="decision" value="allow" autofocus><?= $this->escapeHtml($this->t('consent.allow')) ?></button>
      <button type="submit" name="decision" value="deny" class="secondary"><?= $this->escapeHtml($this->t('consent.deny')) ?></button>
    </form>
    <p class="hint"><?= $this->escapeHtml($this->t('device.review.warning')) ?></p>
<?php endif ?>
