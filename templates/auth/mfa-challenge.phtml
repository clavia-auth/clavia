<?php
?>
<?php $this->placeholder('subtitle')->captureStart() ?>
<?php if ($stepUp): ?>
      <p class="subtitle"><?= $application === null ? 'This sign-in' : $this->escapeHtml($application) ?> needs one more step to confirm it is you.</p>
<?php endif ?>
<?php if ($passkeyOptions !== null): ?>
      <p class="subtitle">Use your passkey<?= $authenticatorApp ? ', or enter the six-digit code from your app' : '' ?>.<?= $recoveryCode ? ' A recovery code works too.' : '' ?></p>
<?php elseif ($authenticatorApp): ?>
      <p class="subtitle">Enter the six-digit code from your app<?= $recoveryCode ? ', or one of your recovery codes' : '' ?>.</p>
<?php else: ?>
      <p class="subtitle">Enter one of your recovery codes.</p>
<?php endif ?>
<?php $this->placeholder('subtitle')->captureEnd() ?>
<?php if ($passkeyOptions !== null): ?>
    <form method="post" action="/auth/mfa/passkey" data-webauthn-get="<?= $this->escapeHtmlAttr($passkeyOptions) ?>">
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => '']) ?>
      <input type="hidden" name="credential" value="">
      <p class="hint" data-webauthn-failed hidden>Your browser did not use the passkey.<?= $codeField ? ' Try again, or use a code.' : ' Try again.' ?></p>
      <button type="submit" data-webauthn-start hidden>Use a passkey</button>
    </form>
<?php endif ?>
<?php if ($codeField): ?>
    <form method="post" action="/auth/mfa" autocomplete="off" novalidate>
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => '']) ?>
<?= $this->partial('partial::code-field', ['label' => $authenticatorApp ? 'Code' : 'Recovery code']) ?>

      <button type="submit"<?php if ($passkeyOptions !== null): ?> class="secondary"<?php endif ?>>Continue</button>
    </form>
<?php endif ?>
