<?php
/**
 * Two-factor settings of the signed-in account: whether it is on, and the way to change it.
 *
 * Variables (set by Clavia\Adapter\Primary\Http\Auth\MfaPages):
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var string $csrfToken
 * @var string $email
 * @var bool   $enabled
 * @var int    $recoveryCodesLeft
 * @var int|null $passkeys   How many passkeys the account holds; null when passkeys are off.
 * @var bool   $onTheWay      Whether a request requiring a second factor sent the person here.
 * @var string|null $application The application asking, when it is named.
 * @var string $loginState    The held request's handle, carried by the forms; empty when not on the way.
 */
?>
<?php $this->placeholder('subtitle')->captureStart() ?>
      <p class="subtitle"><?= $this->escapeHtml($email) ?></p>
<?php if ($onTheWay): ?>
      <p class="subtitle"><?= $this->escapeHtml($application === null
          ? $this->t('mfa.settings.required')
          : $this->t('mfa.settings.required_application', ['application' => $application])) ?></p>
<?php endif ?>
<?php $this->placeholder('subtitle')->captureEnd() ?>
<?php if ($enabled): ?>
    <p class="status status-on"><?= $this->escapeHtml($this->t('mfa.settings.on')) ?></p>
    <p class="hint">
      <?= $this->escapeHtml($this->t('mfa.settings.on_hint')) ?>
      <?= $this->escapeHtml($this->t('mfa.settings.recovery_left', ['count' => $recoveryCodesLeft])) ?>
    </p>
    <form method="post" action="/auth/mfa/disable">
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => '']) ?>
      <button type="submit" class="danger"><?= $this->escapeHtml($this->t('mfa.settings.turn_off')) ?></button>
    </form>
<?php else: ?>
<?php if (($passkeys ?? 0) > 0): ?>
    <p class="status status-on"><?= $this->escapeHtml($this->t('mfa.settings.on_with_passkey')) ?></p>
    <p class="hint"><?= $this->escapeHtml($this->t('mfa.settings.also_app')) ?></p>
<?php else: ?>
    <p class="status status-off"><?= $this->escapeHtml($this->t('mfa.settings.off')) ?></p>
    <p class="hint"><?= $this->escapeHtml($this->t('mfa.settings.off_hint')) ?></p>
<?php endif ?>
    <form method="post" action="/auth/mfa/enroll">
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => $loginState]) ?>
      <button type="submit"><?= $this->escapeHtml($this->t($onTheWay ? 'mfa.settings.set_up_app' : 'mfa.settings.set_up')) ?></button>
    </form>
<?php endif ?>
<?php if ($passkeys !== null): ?>
    <h2 class="section"><?= $this->escapeHtml($this->t('mfa.settings.passkeys')) ?></h2>
    <p class="hint">
<?php if ($passkeys === 0): ?>
      <?= $this->escapeHtml($this->t('mfa.settings.passkeys_none')) ?>
<?php else: ?>
      <?= $this->escapeHtml($this->t('mfa.settings.passkey_count', ['count' => $passkeys])) ?>
<?php if (! $enabled): ?>
      <?= $this->escapeHtml($this->t('mfa.settings.recovery_count', ['count' => $recoveryCodesLeft])) ?>
<?php endif ?>
<?php endif ?>
    </p>
<?php if ($onTheWay): ?>
    <form method="post" action="/auth/passkeys/new">
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => $loginState]) ?>
      <button type="submit" class="secondary"><?= $this->escapeHtml($this->t('mfa.settings.add_passkey_instead')) ?></button>
    </form>
<?php else: ?>
    <form method="get" action="/auth/passkeys">
      <button type="submit" class="secondary"><?= $this->escapeHtml($this->t('mfa.settings.manage_passkeys')) ?></button>
    </form>
<?php endif ?>
<?php endif ?>
