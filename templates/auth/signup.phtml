<?php
/**
 * The sign-up form: an address and a password, in the pool the application opens to
 * sign-ups.
 *
 * Variables (set by Clavia\Adapter\Primary\Http\Auth\AccountPages):
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var string $csrfToken
 * @var string $loginState
 * @var string $email                Prefilled after a refusal, or ''.
 * @var bool   $requiresVerification Whether the account must confirm its address before signing in.
 * @var string $loginHref            Back to the login page of the same request.
 */
?>
<?php $this->placeholder('subtitle')->captureStart() ?>
<?php if ($requiresVerification): ?>
      <p class="subtitle"><?= $this->escapeHtml($this->t('account.sign_up.subtitle_verify')) ?></p>
<?php else: ?>
      <p class="subtitle"><?= $this->escapeHtml($this->t('account.sign_up.subtitle')) ?></p>
<?php endif ?>
<?php $this->placeholder('subtitle')->captureEnd() ?>
    <form method="post" action="/auth/signup" autocomplete="on" novalidate>
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => $loginState]) ?>
<?= $this->partial('partial::field', ['name' => 'email', 'label' => $this->t('login.email'), 'type' => 'email', 'autocomplete' => 'email', 'value' => $email, 'autofocus' => true]) ?>
<?= $this->partial('partial::field', ['name' => 'password', 'label' => $this->t('login.password'), 'type' => 'password', 'autocomplete' => 'new-password', 'value' => '', 'autofocus' => false]) ?>
      <p class="hint"><?= $this->escapeHtml($this->t('account.password_hint', ['min' => $passwordMinLength])) ?></p>

      <button type="submit"><?= $this->escapeHtml($this->t('account.sign_up.submit')) ?></button>
    </form>
    <p class="hint"><?= $this->escapeHtml($this->t('account.sign_up.have_account')) ?> <a href="<?= $this->escapeHtmlAttr($loginHref) ?>"><?= $this->escapeHtml($this->t('account.sign_in')) ?></a></p>
