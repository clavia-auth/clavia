<?php
/**
 * The recovery codes, shown once when two-factor authentication is turned on.
 *
 * Variables (set by Clavia\Adapter\Primary\Http\Auth\MfaPages):
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var list<string> $codes
 * @var string $loginState The held request's handle, on the way to an application; empty otherwise.
 */
?>
<?php $this->placeholder('subtitle')->captureStart() ?>
      <p class="subtitle"><?= $this->escapeHtml($this->t('mfa.codes.subtitle')) ?></p>
<?php $this->placeholder('subtitle')->captureEnd() ?>
    <ul class="codes">
<?php foreach ($codes as $code): ?>
      <li><?= $this->escapeHtml($code) ?></li>
<?php endforeach ?>
    </ul>

<?php if ($loginState !== ''): ?>
    <form method="post" action="/auth/mfa/enroll/continue">
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => $loginState]) ?>
      <button type="submit"><?= $this->escapeHtml($this->t('mfa.continue')) ?></button>
    </form>
<?php else: ?>
    <form method="get" action="/auth/mfa/enroll">
      <button type="submit"><?= $this->escapeHtml($this->t('mfa.codes.done')) ?></button>
    </form>
<?php endif ?>
