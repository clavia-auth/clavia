<?php
/**
 * The passkeys of the signed-in account: each with its name, and the way to add, rename or remove
 * one.
 *
 * Variables (set by Clavia\Adapter\Primary\Http\Auth\PasskeyPages):
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var string $csrfToken
 * @var string $email
 * @var list<array{id: string, name: string, synced: bool, createdAt: int, lastUsedAt: int|null}> $passkeys Dates as timestamps.
 * @var bool   $canAddAnother
 * @var int    $limit
 */
?>
<?php $this->placeholder('subtitle')->captureStart() ?>
      <p class="subtitle"><?= $this->escapeHtml($email) ?></p>
<?php $this->placeholder('subtitle')->captureEnd() ?>
<?php if ($passkeys === []): ?>
    <p class="hint"><?= $this->escapeHtml($this->t('passkeys.none')) ?></p>
<?php else: ?>
    <ul class="passkeys">
<?php foreach ($passkeys as $passkey): ?>
      <li>
        <strong><?= $this->escapeHtml($passkey['name']) ?></strong>
        <span class="hint"><?= $this->escapeHtml($this->t($passkey['synced'] ? 'passkeys.synced' : 'passkeys.one_device')) ?> · <?= $this->escapeHtml($this->t('passkeys.added', ['added' => $passkey['createdAt']])) ?><?php if ($passkey['lastUsedAt'] !== null): ?> · <?= $this->escapeHtml($this->t('passkeys.last_used', ['used' => $passkey['lastUsedAt']])) ?><?php endif ?></span>
        <form method="post" action="/auth/passkeys/<?= $this->escapeHtmlAttr(rawurlencode($passkey['id'])) ?>/name" class="inline">
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => '']) ?>
          <label for="name-<?= $this->escapeHtmlAttr($passkey['id']) ?>"><?= $this->escapeHtml($this->t('passkeys.new_name')) ?></label>
          <input id="name-<?= $this->escapeHtmlAttr($passkey['id']) ?>" name="name" type="text" required maxlength="64" value="<?= $this->escapeHtmlAttr($passkey['name']) ?>">
          <button type="submit" class="secondary"><?= $this->escapeHtml($this->t('passkeys.rename')) ?></button>
        </form>
        <form method="post" action="/auth/passkeys/<?= $this->escapeHtmlAttr(rawurlencode($passkey['id'])) ?>/remove">
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => '']) ?>
          <button type="submit" class="danger"><?= $this->escapeHtml($this->t('passkeys.remove')) ?></button>
        </form>
      </li>
<?php endforeach ?>
    </ul>
<?php endif ?>
<?php if ($canAddAnother): ?>
    <form method="post" action="/auth/passkeys/new">
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => '']) ?>
      <button type="submit"><?= $this->escapeHtml($this->t('passkeys.add.title')) ?></button>
    </form>
<?php else: ?>
    <p class="hint"><?= $this->escapeHtml($this->t('passkeys.at_limit', ['limit' => $limit])) ?></p>
<?php endif ?>
