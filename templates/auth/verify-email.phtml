<?php
/**
 * A verification link's pages: the confirmation it opens on, the confirmed address, and a
 * dead end.
 *
 * Confirming is a POST from the first page, never the GET that showed it: a mail scanner
 * fetching the URL must not spend the link.
 *
 * Variables (set by Clavia\Adapter\Primary\Http\Auth\AccountPages):
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var string $csrfToken
 * @var 'confirm'|'verified'|'failed' $stage
 * @var string $email     confirm and verified
 * @var string $token     confirm: the link's secret, posted back
 * @var string $loginHref Where to sign in next
 */
?>
<?php $this->placeholder('subtitle')->captureStart() ?>
<?php if ($stage === 'confirm'): ?>
      <p class="subtitle"><?= $this->emphasised('account.verify.subtitle', ['email' => $email], 'email') ?></p>
<?php elseif ($stage === 'verified'): ?>
      <p class="subtitle"><?= $this->emphasised('account.verified.subtitle', ['email' => $email], 'email') ?></p>
<?php else: ?>
      <p class="subtitle"><?= $this->escapeHtml($this->t('account.invalid_link.subtitle')) ?></p>
<?php endif ?>
<?php $this->placeholder('subtitle')->captureEnd() ?>
<?php if ($stage === 'confirm'): ?>
    <form method="post" action="/auth/verify-email">
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => '']) ?>
      <input type="hidden" name="token" value="<?= $this->escapeHtmlAttr($token) ?>">
      <button type="submit" autofocus><?= $this->escapeHtml($this->t('account.verify.submit')) ?></button>
    </form>
    <p class="hint"><?= $this->escapeHtml($this->t('account.verify.not_you')) ?></p>
<?php else: ?>
    <p><a class="button" href="<?= $this->escapeHtmlAttr($loginHref) ?>"><?= $this->escapeHtml($this->t('account.sign_in')) ?></a></p>
<?php endif ?>
