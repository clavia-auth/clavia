<?php
/**
 * The login page: the sign-in form, or — for a visitor already signed in with no
 * authorization request to return to — who they are and how to sign out.
 *
 * Variables (set by Clavia\Adapter\Primary\Http\Auth\LoginPages):
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var string      $csrfToken
 * @var string      $loginState
 * @var string      $email      Prefilled after a failed attempt, or ''.
 * @var string|null $signedInAs
 * @var bool        $password   Whether the password form is offered.
 * @var bool        $emailSignIn Whether the email form — a code or a link by email — is offered.
 * @var list<array{label: string, href: string}> $providers External connections, as links.
 * @var string      $signUpHref ''  when sign-up is not offered; otherwise the sign-up page for this request.
 * @var string      $forgotHref ''  when a reset is not offered; otherwise the reset page for this request.
 */
?>
<?php $this->placeholder('subtitle')->captureStart() ?>
<?php if ($signedInAs !== null): ?>
      <p class="subtitle">as <strong><?= $this->escapeHtml($signedInAs) ?></strong>. Go back to the application that sent you here — it will pick this sign-in up.</p>
<?php else: ?>
      <p class="subtitle">Continue to the application that sent you here.</p>
<?php endif ?>
<?php $this->placeholder('subtitle')->captureEnd() ?>
<?php if ($signedInAs !== null): ?>

    <form method="post" action="/auth/logout">
      <button type="submit" class="secondary">Sign out</button>
    </form>
<?php elseif (! $password && ! $emailSignIn && $providers === []): ?>
    <p class="hint">No sign-in method is available for this application. Go back to it and contact its administrator.</p>
<?php else: ?>
<?php if ($password): ?>
    <form method="post" action="/auth/login" autocomplete="on" novalidate>
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => $loginState]) ?>
<?= $this->partial('partial::field', ['name' => 'email', 'label' => 'Email', 'type' => 'email', 'autocomplete' => 'username', 'value' => $email, 'autofocus' => true]) ?>
<?= $this->partial('partial::field', ['name' => 'password', 'label' => 'Password', 'type' => 'password', 'autocomplete' => 'current-password', 'value' => '', 'autofocus' => false]) ?>

      <button type="submit">Sign in</button>
    </form>
<?php if ($forgotHref !== ''): ?>
    <p class="hint"><a href="<?= $this->escapeHtmlAttr($forgotHref) ?>">Forgot your password?</a></p>
<?php endif ?>
<?php endif ?>
<?php if ($emailSignIn): ?>
<?php if ($password): ?>

    <div class="divider"><span>or</span></div>
<?php endif ?>
    <!-- One field, two buttons: the mode is the value of the one pressed, with no script. -->
    <form method="post" action="/auth/passwordless/start" autocomplete="on" novalidate>
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => $loginState]) ?>
<?= $this->partial('partial::field', ['name' => 'email', 'id' => 'passwordless-email', 'label' => 'Email', 'type' => 'email', 'autocomplete' => 'email', 'value' => $email, 'autofocus' => ! $password]) ?>

      <button type="submit" name="mode" value="code"<?php if ($password): ?> class="secondary"<?php endif ?>>Email me a code</button>
      <button type="submit" name="mode" value="link" class="secondary">Email me a sign-in link</button>
    </form>
<?php endif ?>
<?php if ($providers !== []): ?>
<?php if ($password || $emailSignIn): ?>

    <div class="divider"><span>or</span></div>
<?php endif ?>
    <!-- Links, not a form: starting an external sign-in is a navigation. The login
         page's handle rides along, so the sign-in comes back to the same request. -->
    <ul class="providers">
<?php foreach ($providers as $provider): ?>
      <li><a class="provider" href="<?= $this->escapeHtmlAttr($provider['href']) ?>">Continue with <?= $this->escapeHtml($provider['label']) ?></a></li>
<?php endforeach ?>
    </ul>
<?php endif ?>
<?php if ($signUpHref !== ''): ?>
    <p class="hint">New here? <a href="<?= $this->escapeHtmlAttr($signUpHref) ?>">Create an account</a></p>
<?php endif ?>
<?php endif ?>
