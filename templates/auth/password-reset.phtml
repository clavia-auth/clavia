<?php
/**
 * A reset link's pages: the new-password form it opens on, and the changed password.
 *
 * Variables (set by Clavia\Adapter\Primary\Http\Auth\AccountPages):
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var string $csrfToken
 * @var 'form'|'changed' $stage
 * @var string $email     The account's address.
 * @var string $token     form: the link's secret, posted back
 * @var string $loginHref Where to sign in next
 */
?>
<?php $this->placeholder('subtitle')->captureStart() ?>
<?php if ($stage === 'form'): ?>
      <p class="subtitle">For <strong><?= $this->escapeHtml($email) ?></strong>. Choosing a new password signs you out everywhere.</p>
<?php else: ?>
      <p class="subtitle">You are signed out everywhere. Sign in as <strong><?= $this->escapeHtml($email) ?></strong> with your new password.</p>
<?php endif ?>
<?php $this->placeholder('subtitle')->captureEnd() ?>
<?php if ($stage === 'form'): ?>
    <form method="post" action="/auth/password/reset" novalidate>
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => '']) ?>
      <input type="hidden" name="token" value="<?= $this->escapeHtmlAttr($token) ?>">
      <input type="hidden" name="email" value="<?= $this->escapeHtmlAttr($email) ?>" autocomplete="username">
<?= $this->partial('partial::field', ['name' => 'password', 'label' => 'New password', 'type' => 'password', 'autocomplete' => 'new-password', 'value' => '', 'autofocus' => true]) ?>
      <p class="hint">At least 8 characters.</p>

      <button type="submit">Change password</button>
    </form>
<?php else: ?>
    <p><a class="button" href="<?= $this->escapeHtmlAttr($loginHref) ?>">Sign in</a></p>
<?php endif ?>
