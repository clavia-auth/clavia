<?php
/**
 * Where the code sent by email is typed. It answers the challenge this browser's cookie
 * names, and no other: the page says so, so nobody tries it on another device.
 *
 * Variables (set by Clavia\Adapter\Primary\Http\Auth\PasswordlessPages):
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var string $csrfToken
 * @var string $email The address the code went to.
 */
?>
<?php $this->placeholder('subtitle')->captureStart() ?>
      <p class="subtitle"><?= $this->emphasised('passwordless.code.subtitle', ['email' => $email], 'email') ?></p>
<?php $this->placeholder('subtitle')->captureEnd() ?>
    <form method="post" action="/auth/passwordless/code" autocomplete="off" novalidate>
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => '']) ?>
<?= $this->partial('partial::code-field', ['label' => $this->t('mfa.code')]) ?>

      <button type="submit"><?= $this->escapeHtml($this->t('login.submit')) ?></button>
    </form>
    <p class="hint"><?= $this->escapeHtml($this->t('account.check_inbox.nothing_arrived')) ?> <a href="/auth/login"><?= $this->escapeHtml($this->t('passwordless.start_again')) ?></a></p>
