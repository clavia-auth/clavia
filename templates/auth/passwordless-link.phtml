<?php
/**
 * A sign-in link's pages: sent, the confirmation it opens on, and a dead end.
 *
 * The sign-in is a POST from the confirmation, never the GET that showed it: a mail
 * scanner or a link preview fetching the URL must not spend it.
 *
 * Variables (set by Clavia\Adapter\Primary\Http\Auth\PasswordlessPages):
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var string $csrfToken
 * @var 'sent'|'confirm'|'failed' $stage
 * @var string $email sent and confirm
 * @var string $token confirm: the link's secret, posted back
 */
?>
<?php $this->placeholder('subtitle')->captureStart() ?>
<?php if ($stage === 'sent'): ?>
      <p class="subtitle"><?= $this->emphasised('passwordless.link.sent', ['email' => $email], 'email') ?></p>
<?php elseif ($stage === 'confirm'): ?>
      <p class="subtitle"><?= $this->emphasised('passwordless.link.confirm', ['email' => $email], 'email') ?></p>
<?php else: ?>
      <p class="subtitle"><?= $this->escapeHtml($this->t('passwordless.link.ask_again')) ?> <a href="/auth/login"><?= $this->escapeHtml($this->t('passwordless.start_again')) ?></a></p>
<?php endif ?>
<?php $this->placeholder('subtitle')->captureEnd() ?>
<?php if ($stage === 'confirm'): ?>
    <form method="post" action="/auth/passwordless/verify">
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => '']) ?>
      <input type="hidden" name="token" value="<?= $this->escapeHtmlAttr($token) ?>">
      <button type="submit" autofocus><?= $this->escapeHtml($this->t('login.submit')) ?></button>
    </form>
    <p class="hint"><?= $this->escapeHtml($this->t('passwordless.link.not_you')) ?></p>
<?php elseif ($stage === 'sent'): ?>
    <p class="hint"><?= $this->escapeHtml($this->t('account.check_inbox.nothing_arrived')) ?> <a href="/auth/login"><?= $this->escapeHtml($this->t('passwordless.start_again')) ?></a></p>
<?php endif ?>
