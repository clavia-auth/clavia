<?php
/**
 * Enrolling an authenticator: the seed as a QR code and as text, then the code that
 * proves the app holds it.
 *
 * Variables (set by Clavia\Adapter\Primary\Http\Auth\MfaPages):
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var string $csrfToken
 * @var string $secret The base32 seed.
 * @var string $qrSvg  SVG markup generated by Clavia\Adapter\Primary\Http\Auth\QrCodeSvg —
 *                     drawn by this server from the seed, holding no text; printed as is.
 * @var string $loginState The held request's handle, on the way to an application; empty otherwise.
 */
?>
<?php $this->placeholder('subtitle')->captureStart() ?>
      <p class="subtitle"><?= $this->escapeHtml($this->t('mfa.set_up.subtitle')) ?></p>
<?php $this->placeholder('subtitle')->captureEnd() ?>
    <div class="qr"><?= $qrSvg ?></div>

    <p class="hint"><?= $this->escapeHtml($this->t('mfa.set_up.cant_scan')) ?></p>
    <p class="secret"><?= $this->escapeHtml($secret) ?></p>

    <form method="post" action="/auth/mfa/enroll/confirm" autocomplete="off" novalidate>
<?= $this->partial('partial::csrf', ['csrfToken' => $csrfToken, 'loginState' => $loginState]) ?>
<?= $this->partial('partial::code-field', ['label' => $this->t('mfa.set_up.code_label')]) ?>

      <button type="submit"><?= $this->escapeHtml($this->t('mfa.set_up.turn_on')) ?></button>
    </form>
